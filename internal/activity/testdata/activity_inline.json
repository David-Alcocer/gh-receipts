{"data":{"search":{"issueCount":5,"pageInfo":{"hasNextPage":false,"endCursor":"Y3Vyc29yOjU="},"nodes":[{"__typename":"PullRequest","id":"PR_kwDODKw3uc8AAAABCOVfjg","number":14355,"title":"Remove obsolete Git test seams","url":"https://github.com/cli/cli/pull/14355","createdAt":"2026-09-04T15:50:28Z","mergedAt":"2026-10-30T17:30:35Z","author":{"__typename":"User","login":"williammartin"},"reviews":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpO0MjAyNi0xMC0yOVQxMDoyNjoxNFq0MjAyNi0xMC0yOVQxMDoyNjoxNFrPAAAAAVOFEOA="},"nodes":[{"state":"COMMENTED","submittedAt":"2026-10-29T10:26:14Z","url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5696196832","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:49:30Z","url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5704027365","author":{"__typename":"User","login":"williammartin"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:58:59Z","url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5704142148","author":{"__typename":"User","login":"williammartin"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:01:20Z","url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5704169829","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"APPROVED","submittedAt":"2026-10-30T17:28:06Z","url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5716117801","author":{"__typename":"User","login":"BagToad"}}]},"comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":null},"nodes":[]},"reviewThreads":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0OTozMFrOsbouYQ=="},"nodes":[{"id":"PRRT_kwDODKw3uc6xui5h","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0OTozMFrPAAAAAQdIiVU="},"nodes":[{"url":"https://github.com/cli/cli/pull/14355#discussion_r4417161557","bodyText":"assert.Equal compares the buffers’ contents, not their identity. Here, all three are empty bytes.Buffer values, so accidentally wiring cmd.Stdout = errOut would still pass.\nassert.Same checks that each command stream points to the exact buffer supplied by the caller. That’s the contract this test is checking, and it catches swapped streams or replacement buffers.","createdAt":"2026-10-29T19:49:30Z","author":{"__typename":"User","login":"williammartin"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5704027365"}}]}},{"id":"PRRT_kwDODKw3uc6xuwjO","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo1OTowMFrPAAAAAQdJ7NM="},"nodes":[{"url":"https://github.com/cli/cli/pull/14355#discussion_r4417252563","bodyText":"This is a small change, instead of TestMain we call directly into a helper test function. Using -test.run keeps the helper entry point in a single test rather than adding subprocess dispatch to a package-wide TestMain.\nAlso made a small change to use cmd line args rather than env vars just to keep it a bit cleaner and avoid env var shenanigans e.g. leaving cmd.Env unset, avoiding the need to append its settings to os.Environ().","createdAt":"2026-10-29T19:59:00Z","author":{"__typename":"User","login":"williammartin"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14355#pullrequestreview-5704142148"}}]}}]}},{"__typename":"PullRequest","id":"PR_kwDODKw3uc8AAAABCOPE-w","number":14351,"title":"Improve git client tests","url":"https://github.com/cli/cli/pull/14351","createdAt":"2026-09-04T15:36:50Z","mergedAt":"2026-10-30T17:30:33Z","author":{"__typename":"User","login":"williammartin"},"reviews":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpO0MjAyNi0xMC0yOVQxMDoyNjo0OFq0MjAyNi0xMC0yOVQxMDoyNjo0N1rPAAAAAVOFK3I="},"nodes":[{"state":"COMMENTED","submittedAt":"2026-10-29T10:26:48Z","url":"https://github.com/cli/cli/pull/14351#pullrequestreview-5696203634","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:02:17Z","url":"https://github.com/cli/cli/pull/14351#pullrequestreview-5704180544","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"APPROVED","submittedAt":"2026-10-30T17:28:05Z","url":"https://github.com/cli/cli/pull/14351#pullrequestreview-5716117527","author":{"__typename":"User","login":"BagToad"}}]},"comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":null},"nodes":[]},"reviewThreads":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxMDoyNjo0N1rOsYIbHg=="},"nodes":[{"id":"PRRT_kwDODKw3uc6xghse","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxMDoyNjo0N1rPAAAAAQbtfoA="},"nodes":[{"url":"https://github.com/cli/cli/pull/14351#discussion_r4411195008","bodyText":"🛑 Requirement: Use a fatal assertion for the error-message check\nAGENTS.md requires require rather than assert for error checks. Use require.EqualError here so a diagnostic mismatch stops the test before the output assertion.","createdAt":"2026-10-29T10:26:47Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14351#pullrequestreview-5696203634"}}]}}]}},{"__typename":"PullRequest","id":"PR_kwDODKw3uc8AAAABCOJMMQ","number":14350,"title":"Test git transports with local remotes","url":"https://github.com/cli/cli/pull/14350","createdAt":"2026-09-04T15:25:04Z","mergedAt":"2026-10-30T17:30:32Z","author":{"__typename":"User","login":"williammartin"},"reviews":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpO0MjAyNi0xMC0yOVQxMDoyNjo1NVq0MjAyNi0xMC0yOVQxMDoyNjo1NVrPAAAAAVOFMdI="},"nodes":[{"state":"COMMENTED","submittedAt":"2026-10-29T10:26:55Z","url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5696205266","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:46:41Z","url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5703994422","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:13:38Z","url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5704325553","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"APPROVED","submittedAt":"2026-10-30T17:28:03Z","url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5716117239","author":{"__typename":"User","login":"BagToad"}}]},"comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":null},"nodes":[]},"reviewThreads":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0Njo0MFrOsbnvnA=="},"nodes":[{"id":"PRRT_kwDODKw3uc6xue-c","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0Njo0MFrPAAAAAQdIIqo="},"nodes":[{"url":"https://github.com/cli/cli/pull/14350#discussion_r4417135274","bodyText":"🛑 Requirement: Retain coverage of pull's repository-directory modifier\nThe removed pull table checked command modifiers, but all replacement pull scenarios use the client's configured directory without passing a modifier. Ignoring modifiers in Pull would now pass these tests, although issue develop relies on this override when updating an existing worktree (pkg/cmd/issue/develop/develop.go:398). Please exercise this successful pull through WithRepoDir, as the new fetch scenario does.","createdAt":"2026-10-29T19:46:40Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5703994422"}}]}},{"id":"PRRT_kwDODKw3uc6xue_n","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0Njo0MVrPAAAAAQdIIx4="},"nodes":[{"url":"https://github.com/cli/cli/pull/14350#discussion_r4417135390","bodyText":"🛑 Requirement: Retain coverage of push's repository-directory modifier\nThe previous push table included a command-modifier case, but none of the replacement push tests passes a modifier. The repository-state assertions therefore would not catch Push dropping its modifier loop. Please perform this push with a separate client and WithRepoDir so the conversion preserves that regression coverage while checking the remote ref and upstream configuration.","createdAt":"2026-10-29T19:46:41Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14350#pullrequestreview-5703994422"}}]}}]}},{"__typename":"PullRequest","id":"PR_kwDODKw3uc8AAAABCOBNjA","number":14349,"title":"Refactor git graph tests to use real repositories","url":"https://github.com/cli/cli/pull/14349","createdAt":"2026-09-04T15:10:43Z","mergedAt":"2026-10-30T17:30:30Z","author":{"__typename":"User","login":"williammartin"},"reviews":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpO0MjAyNi0xMC0yOVQxMDoyOToyOFq0MjAyNi0xMC0yOVQxMDoyOToyNlrPAAAAAVOFpEk="},"nodes":[{"state":"COMMENTED","submittedAt":"2026-10-29T10:29:28Z","url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5696234569","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:42:43Z","url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5703948659","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:14:05Z","url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5704332119","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"APPROVED","submittedAt":"2026-10-30T17:28:02Z","url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5716116944","author":{"__typename":"User","login":"BagToad"}}]},"comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":null},"nodes":[]},"reviewThreads":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxMDoyOToyN1rOsYJUOA=="},"nodes":[{"id":"PRRT_kwDODKw3uc6xglQ4","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxMDoyOToyN1rPAAAAAQbt2ak="},"nodes":[{"url":"https://github.com/cli/cli/pull/14349#discussion_r4411218345","bodyText":"💭 Commentary: Preserve coverage of forced branch deletion\nThe feature branch points to the same commit as trunk, so this test also passes if DeleteLocalBranch is changed from forced deletion to ordinary deletion. The removed test explicitly checked the force flag, which matters when closing an unmerged PR or cleaning up after a squash merge. Create a feature-only commit and switch back to trunk before deleting the branch so the real-repository test preserves that regression coverage.","createdAt":"2026-10-29T10:29:27Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5696234569"}}]}},{"id":"PRRT_kwDODKw3uc6xglRz","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxMDoyOToyN1rPAAAAAQbt2fg="},"nodes":[{"url":"https://github.com/cli/cli/pull/14349#discussion_r4411218424","bodyText":"🛑 Requirement: Remove the unsupported cherry-pick option\nGit cherry-pick does not support --quiet, so this setup command exits with a usage error. The run helper immediately fails the test, preventing it from reaching the Commits assertions. Remove --quiet; the helper already captures command output.","createdAt":"2026-10-29T10:29:27Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5696234569"}}]}},{"id":"PRRT_kwDODKw3uc6xuZdM","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTo0Mjo0M1rPAAAAAQdHkxs="},"nodes":[{"url":"https://github.com/cli/cli/pull/14349#discussion_r4417098523","bodyText":"🛑 Requirement: Use a fatal assertion for the filesystem error check\nThe testing guide at docs/testing.md:55-57 requires error checks to use require rather than assert. Use require.ErrorIs here so an unexpected filesystem result stops the scenario before the subsequent worktree assertions.","createdAt":"2026-10-29T19:42:43Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14349#pullrequestreview-5703948659"}}]}}]}},{"__typename":"PullRequest","id":"PR_kwDODKw3uc8AAAABCN5T1A","number":14348,"title":"Test git client with real repositories","url":"https://github.com/cli/cli/pull/14348","createdAt":"2026-09-04T14:57:13Z","mergedAt":"2026-10-30T17:30:28Z","author":{"__typename":"User","login":"williammartin"},"reviews":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpO0MjAyNi0wOS0wNFQxNDo1OTo1MFq0MjAyNi0wOS0wNFQxNDo1OTo0OVrPAAAAATDaX_E="},"nodes":[{"state":"COMMENTED","submittedAt":"2026-09-04T14:59:50Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5114585073","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-09-04T15:16:04Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5114790350","author":{"__typename":"User","login":"williammartin"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:31:45Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5703811391","author":{"__typename":"User","login":"williammartin"}},{"state":"COMMENTED","submittedAt":"2026-10-29T19:38:15Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5703897211","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:17:57Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5704383371","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"COMMENTED","submittedAt":"2026-10-29T20:27:49Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5704508769","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"}},{"state":"APPROVED","submittedAt":"2026-10-30T17:28:00Z","url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5716116673","author":{"__typename":"User","login":"BagToad"}}]},"comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":null},"nodes":[]},"reviewThreads":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0wOS0wNFQxNDo1OTo0OVrOn1aI3A=="},"nodes":[{"id":"PRRT_kwDODKw3uc6fVojc","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0wOS0wNFQxNDo1OTo0OVrO6o8Otw=="},"nodes":[{"url":"https://github.com/cli/cli/pull/14348#discussion_r3935243959","bodyText":"🛑 Requirement: Inspect the expected error, not the actual error\nThis branch currently extracts GitError from err, then compares that same actual error to itself, so incorrect exit codes or stderr can pass unnoticed. Extract from tt.wantError so the assertions validate the result against the fixture.","createdAt":"2026-09-04T14:59:49Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5114585073"}},{"url":"https://github.com/cli/cli/pull/14348#discussion_r3935376542","bodyText":"Fixed in e499547. The test now extracts the expected GitError from tt.wantError, then compares the actual error's exit code and stderr against that fixture.","createdAt":"2026-09-04T15:16:04Z","author":{"__typename":"User","login":"williammartin"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5114790350"}}]}},{"id":"PRRT_kwDODKw3uc6xuJSm","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTozMTo0NVrPAAAAAQdF57o="},"nodes":[{"url":"https://github.com/cli/cli/pull/14348#discussion_r4416989114","bodyText":"This helps preserve Go’s coverage environment in the subprocess mocks. However, it will be removed again in a later PR: #14355","createdAt":"2026-10-29T19:31:45Z","author":{"__typename":"User","login":"williammartin"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5703811391"}}]}},{"id":"PRRT_kwDODKw3uc6xuThR","comments":{"pageInfo":{"hasPreviousPage":false,"startCursor":"Y3Vyc29yOnYyOpK0MjAyNi0xMC0yOVQxOTozODoxNVrPAAAAAQdG9SI="},"nodes":[{"url":"https://github.com/cli/cli/pull/14348#discussion_r4417058082","bodyText":"🛑 Requirement: Isolate the default global ignore file\nRedirecting Git's global configuration does not disable its default ignore file at $XDG_CONFIG_HOME/git/ignore (or ~/.config/git/ignore). The new repository harness still inherits that file: a developer's .github/skills rule makes TestClientIsIgnoredReturnsFalseForUnignoredPath fail, and a *.txt rule prevents the tracked-file scenario from adding its fixture. Explicitly set core.excludesFile to a test-owned empty file so these real-Git tests do not depend on the operator's ignore rules.","createdAt":"2026-10-29T19:38:15Z","author":{"__typename":"Bot","login":"copilot-pull-request-reviewer"},"pullRequestReview":{"url":"https://github.com/cli/cli/pull/14348#pullrequestreview-5703897211"}}]}}]}}]}}}